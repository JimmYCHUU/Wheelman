{
  "name": "wheelman",
  "version": "0.2.0",
  "private": true,
  "description": "A reply assistant for a used-car dealer: reads the dashboard, Marketplace chats, auction orders and the business phone, drafts replies with free AI models behind a verification step, and sends nothing by itself. A Marketplace reply goes only when a person presses Send; everything else is copy and paste.",
  "license": "UNLICENSED",
  "author": "JimmYCHUU",
  "repository": {
    "type": "git",
    "url": "https://github.com/JimmYCHUU/Wheelman.git"
  },
  "homepage": "https://github.com/JimmYCHUU/Wheelman#readme",
  "bugs": {
    "url": "https://github.com/JimmYCHUU/Wheelman/issues"
  },
  "keywords": [
    "reply-assistant",
    "dealer",
    "crm",
    "sms",
    "llm",
    "gemini",
    "openrouter",
    "node-sqlite",
    "zero-dependency",
    "windows"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/app.js",
    "import-history": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/import-history.js",
    "build-voice": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/build-voice.js",
    "fetch-website": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/fetch-website.js",
    "check-login": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/check-login.js",
    "check-model": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/check-model.js",
    "replay": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/replay.js",
    "report": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/report.js",
    "backup": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/backup.js",
    "restore": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/restore.js",
    "check-private": "node --disable-warning=ExperimentalWarning scripts/check-private.js",
    "check-css": "node scripts/check-css-budget.js",
    "check-deps": "node scripts/check-deps.js",
    "release-notes": "node scripts/release-notes.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  }
}
