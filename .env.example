# Copy this file to ".env" and fill in the blanks. Never share the .env file.

# --- Carbarn dashboard login (the agent only reads; it never sends or changes anything)
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- AI model keys
# Main: Google Gemini free tier. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Backup (optional): OpenRouter. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Models
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Behaviour
# Address of the local page: http://localhost:3210
PORT=3210
# How often to check the dashboard for new messages
SYNC_MINUTES=3
# Only draft replies for customer messages newer than this
DRAFT_MAX_AGE_HOURS=72
# Safety cap on AI requests per day (free tiers have daily limits)
DAILY_DRAFT_LIMIT=200
# Minimum seconds between AI requests (free tiers have per-minute limits)
SECONDS_BETWEEN_DRAFTS=8
# Sign-off added to the first reply to a customer each day. Leave empty for none.
SIGN_OFF=Regards,\nTeam Carbarn

# --- Where things are read from (ask whoever runs the dashboard and the content engine)
# The address of the dashboard's data service, starting with https://
DASHBOARD_API_URL=

# --- Facebook Marketplace section (read from the content engine; read-only)
# The address of the Marketplace inbox. Leave empty to keep the section off.
MARKETPLACE_URL=
# Set to 0 to switch the Marketplace section off even when the address is filled in
MARKETPLACE_ENABLED=1
# Most Marketplace suggestions written in any 24 hours, so the dashboard keeps its share of the free AI allowance
MARKETPLACE_DAILY_DRAFTS=60
